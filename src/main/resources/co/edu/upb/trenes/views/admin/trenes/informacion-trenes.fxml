<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.upb.trenes.controllers.admin.trenes.InformacionTrenesController"
      spacing="18" prefWidth="1280" prefHeight="780" styleClass="root-pane page-container">
    <padding><Insets top="28" right="34" bottom="28" left="34"/></padding>
    <Label text="Administrador / Informacion de Trenes" styleClass="page-title"/>
    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <TableView fx:id="trenesTable" prefHeight="560" HBox.hgrow="ALWAYS" styleClass="table-card">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="210"/>
                <TableColumn fx:id="tipoColumn" text="Tipo" prefWidth="150"/>
                <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="140"/>
                <TableColumn fx:id="kilometrajeColumn" text="Kilometraje" prefWidth="140"/>
                <TableColumn fx:id="rutaColumn" text="Ruta asignada" prefWidth="180"/>
            </columns>
        </TableView>
        <VBox spacing="10" styleClass="detail-card" prefWidth="420">
            <Label text="Detalle seleccionado" styleClass="section-title"/>
            <Label fx:id="detalleLabel" text="Seleccione un tren para visualizar su informacion." wrapText="true"/>
        </VBox>
    </HBox>
    <Button text="Volver" onAction="#volver" styleClass="secondary-button"/>
</VBox>

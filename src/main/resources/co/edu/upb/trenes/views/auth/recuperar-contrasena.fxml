<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.upb.trenes.controllers.auth.RecuperarContrasenaController"
      spacing="14" alignment="CENTER" minWidth="1180" prefWidth="1280" styleClass="root-pane page-container">
    <VBox spacing="12" maxWidth="420" styleClass="panel elevated">
        <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
        <Label text="Recuperar acceso" styleClass="title"/>
        <TextField fx:id="usuarioField" promptText="Usuario"/>
        <Button text="Buscar usuario" onAction="#buscarUsuario" styleClass="primary-button" maxWidth="Infinity"/>
        <Button text="Volver" onAction="#volver" styleClass="secondary-button" maxWidth="Infinity"/>
    </VBox>
</VBox>

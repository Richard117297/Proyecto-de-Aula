<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.upb.trenes.controllers.boletos.CompraBoletoController"
      spacing="12" prefWidth="800" prefHeight="520" styleClass="root-pane">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Compra de boleto" styleClass="title"/>
    <Button text="Crear boleto de prueba" onAction="#crearBoletoDemo"/>
    <Label fx:id="estadoLabel"/>
</VBox>

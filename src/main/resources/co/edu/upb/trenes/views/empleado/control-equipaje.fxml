<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.upb.trenes.controllers.empleado.ControlEquipajeEmpleadoController"
      spacing="18" prefWidth="1280" prefHeight="780" styleClass="root-pane page-container">
    <padding><Insets top="28" right="34" bottom="28" left="34"/></padding>
    <Label text="Empleado / Control de Equipaje" styleClass="page-title"/>
    <HBox spacing="18">
        <VBox spacing="12" styleClass="form-card" HBox.hgrow="ALWAYS">
            <Label text="Seleccione boleto" styleClass="section-title"/>
            <ComboBox fx:id="boletoCombo" maxWidth="Infinity"/>
            <TextField fx:id="pesoField" promptText="Peso del equipaje en kg"/>
            <Label fx:id="contadorLabel" text="Maletas registradas: 0 / 2" styleClass="status-badge"/>
            <Label text="Maximo permitido: 80 kg por maleta" styleClass="hint"/>
            <Button text="Registrar equipaje" onAction="#registrar" styleClass="primary-button"/>
        </VBox>
        <VBox spacing="10" styleClass="detail-card" prefWidth="440">
            <Label text="Detalle del boleto" styleClass="section-title"/>
            <Label fx:id="detalleLabel" text="Seleccione un boleto para visualizar pasajero, ruta y equipaje." wrapText="true"/>
        </VBox>
    </HBox>
    <Button text="Volver" onAction="#volver" styleClass="secondary-button"/>
</VBox>

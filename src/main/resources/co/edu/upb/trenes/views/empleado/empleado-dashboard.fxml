<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.upb.trenes.controllers.empleado.EmpleadoDashboardController"
            prefWidth="1280" prefHeight="780" styleClass="root-pane">
    <left>
        <VBox spacing="12" styleClass="sidebar">
            <padding><Insets top="24" right="18" bottom="24" left="18"/></padding>
            <Label text="Empleado" styleClass="sidebar-title"/>
            <Button fx:id="validarButton" text="Validar boletos" onAction="#validarBoletos"/>
            <Button text="Control de equipaje" onAction="#controlEquipaje"/>
            <Button text="Entregar equipaje" onAction="#entregarEquipaje"/>
            <Button text="Lista de pasajeros" onAction="#listaPasajeros"/>
            <Button text="Cerrar sesion" onAction="#cerrarSesion" styleClass="secondary-button"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="18" alignment="TOP_CENTER" styleClass="content">
            <padding><Insets top="34" right="34" bottom="34" left="34"/></padding>
            <Label text="Panel Empleado" styleClass="title"/>
            <Label text="Valida boletos, controla equipaje y acompana el abordaje operativo." styleClass="lead"/>
            <ImageView fitWidth="780" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../../images/logoStaffTrain2.jpeg"/>
                </image>
            </ImageView>
        </VBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.upb.trenes.controllers.empleado.ValidarBoletosController"
      spacing="18" prefWidth="1280" prefHeight="780" styleClass="root-pane page-container">
    <padding><Insets top="28" right="34" bottom="28" left="34"/></padding>
    <Label text="Empleado / Validacion de Boletos" styleClass="page-title"/>
    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <TableView fx:id="boletosTable" HBox.hgrow="ALWAYS" styleClass="table-card">
            <columns>
                <TableColumn fx:id="idColumn" text="ID boleto" prefWidth="220"/>
                <TableColumn fx:id="pasajeroColumn" text="Pasajero" prefWidth="160"/>
                <TableColumn fx:id="origenColumn" text="Origen" prefWidth="80"/>
                <TableColumn fx:id="destinoColumn" text="Destino" prefWidth="80"/>
                <TableColumn fx:id="categoriaColumn" text="Categoria" prefWidth="120"/>
                <TableColumn fx:id="valorColumn" text="Valor" prefWidth="100"/>
                <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="170"/>
            </columns>
        </TableView>
        <VBox spacing="12" styleClass="detail-card" prefWidth="420">
            <Label text="Detalle del boleto" styleClass="section-title"/>
            <Label fx:id="detalleLabel" text="Seleccione un boleto para visualizar su informacion completa." wrapText="true"/>
            <TextField fx:id="motivoField" promptText="Motivo si se rechaza"/>
            <Button text="Validar boleto" onAction="#validar" styleClass="success-button"/>
            <Button text="Rechazar boleto" onAction="#rechazar" styleClass="danger-button"/>
        </VBox>
    </HBox>
    <Button text="Volver" onAction="#volver" styleClass="secondary-button"/>
</VBox>

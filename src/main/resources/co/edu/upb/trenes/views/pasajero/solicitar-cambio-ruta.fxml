<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.upb.trenes.controllers.pasajero.SolicitarCambioRutaController"
      spacing="18" prefWidth="1280" prefHeight="780" styleClass="root-pane page-container">
    <padding><Insets top="28" right="34" bottom="28" left="34"/></padding>
    <Label text="Pasajero / Solicitar Cambio de Ruta" styleClass="page-title"/>
    <HBox spacing="18">
        <VBox spacing="12" styleClass="form-card" HBox.hgrow="ALWAYS">
            <Label text="Seleccione los datos de cambio" styleClass="section-title"/>
            <ComboBox fx:id="boletoCombo" maxWidth="Infinity"/>
            <ComboBox fx:id="nuevaRutaCombo" maxWidth="Infinity"/>
            <ComboBox fx:id="nuevoDestinoCombo" maxWidth="Infinity"/>
            <Button text="Solicitar cambio" onAction="#solicitar" styleClass="primary-button"/>
        </VBox>
        <VBox spacing="10" styleClass="detail-card" prefWidth="430">
            <Label text="Comparacion de ruta" styleClass="section-title"/>
            <Label fx:id="detalleLabel" text="Seleccione un boleto para comparar rutas." wrapText="true"/>
        </VBox>
    </HBox>
    <Button text="Volver" onAction="#volver" styleClass="secondary-button"/>
</VBox>
